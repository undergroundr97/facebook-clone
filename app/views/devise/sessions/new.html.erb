<div id="log-in-card">
  
  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-inputs">
    
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email"},
                    label: false,
                    placeholder: 'Email'%>
   
      <%= f.input :password,
                  placeholder: 'Password',
                  required: false,
                  label:false, 
                  input_html: { autocomplete: "current-password" } %>
      <div class="log-in-options">

         <%= f.button :submit, "Log in", class:'log-in-btn'%>
         <br>
      </div>
      <%= f.input :remember_me, as: :boolean, wrapper_html: {class:'checkbox-wrapper-13'}, label_html:{class:'label-class'} if devise_mapping.rememberable? %>
  <br>
  <div class="password-recovery">
    <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %> 
    <%= link_to "Forgot your password?", new_password_path(resource_name) %>
    <% end %>
  </div>  <br>

      
    
    <div class="sign-up-btn">
      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
      <%= link_to "Sign up for free", new_registration_path(resource_name) %><br />
      <% end %>
    </div>

  <% end %>
  

</div>
