<div id="<%= dom_id post %>">

  <div class="vitao"><H2>lorem ipsum dolor</H2></div>
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= post.body %>
  </p>
  <p>
    <strong>Author:</strong>
    <%= post.post_creator&.name%>
  </p>
<p>
  <strong>Likes:</strong>
  <%= post.likes%>
</p>
<p>
  <strong>Post Creator_ID:</strong>
  <%= post.post_creator.id%>
</p>
  <p>
    <strong>
      Post comments:
      <% comments = @comments || []%>
      <% comments.each do |comment|%>
      <p><%= comment.body%></p>
      <%end%>
    </strong>
  </p>
</div>
