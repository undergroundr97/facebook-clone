<%= form_with(model: profile) do |form| %>
  <% if profile.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>

      <ul>
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<%= profile.to_s%>
<%= current_user.id%>
<%= "o valor eh: #{@user_id}"%>
<%= simple_form_for profile do |f|%>
<%= f.input :user_id, as: :hidden, input_html: { value: @user_id}%>
<%= f.input :name %>
<%= f.input :surname%>
<%= f.input :location%>
<%= f.input :birthdate, as: :date%>
<%= f.input :gender, collection: ['Male', 'Female', 'Other'], default: 'Male'%>
<%= f.submit%>
<%end%>