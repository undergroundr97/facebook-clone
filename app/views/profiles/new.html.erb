<% content_for :title, "New profile" %>

<h1>New profile</h1>

<%= render "form", profile: @profile %>

<%= simple_form_for @profile do |f|%>
<%= f.input :user_id, as: :hidden, input_html: { value: @user_id}%>
<%= f.input :name %>
<%= f.input :surname%>
<%= f.input :location%>
<%= f.input :birthdate, as: :date%>
<%= f.input :gender, collection: ['Male', 'Female', 'Other'], default: 'Male'%>
<%= f.submit%>
<%end%>

<br>

<div>
  <%= link_to "Back to profiles", profiles_path %>
</div>
